PORT=3000
NODE_ENV=development
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DATABASE_URL="file:./dev.db"

JWT_ACCESS_SECRET="enterprise-super-secret-access-key-32-chars-long"
JWT_REFRESH_SECRET="enterprise-super-secret-refresh-key-32-chars-long"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

MAIL_PROVIDER=memory
MAIL_FROM="no-reply@enterprise-app.com"

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""

WEBHOOK_SECRET="webhook-secret-key-for-signing"
