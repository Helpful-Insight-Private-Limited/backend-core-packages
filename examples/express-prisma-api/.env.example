# Application
PORT=3000
NODE_ENV=development
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Database (SQLite default for zero-config testing; or postgresql://user:pass@localhost:5432/mydb)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="enterprise-super-secret-access-key-32-chars-long"
JWT_REFRESH_SECRET="enterprise-super-secret-refresh-key-32-chars-long"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Mail Service (Supported: memory | smtp | ses | sendgrid | mailgun)
MAIL_PROVIDER=memory
MAIL_FROM="no-reply@enterprise-app.com"

# SMTP Settings (when MAIL_PROVIDER=smtp)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""

# Webhook Secret for outgoing webhook signing
WEBHOOK_SECRET="webhook-secret-key-for-signing"
